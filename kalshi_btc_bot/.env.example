# ── Kalshi Credentials ───────────────────────────────────────────────
ENVIRONMENT=demo              # demo | prod
KALSHI_KEY_ID=your-key-id-here
KALSHI_PRIVATE_KEY_PATH=./kalshi.key   # path to RSA private key PEM file
LIVE_TRADING=false            # set true ONLY when ready for real orders

# ── Market Selection ─────────────────────────────────────────────────
SERIES_CATEGORY=crypto
SERIES_TAGS=btc,bitcoin
BTC_SPOT_FEED=coinbase
BTC_SYMBOL=BTC-USD

REFRESH_MARKETS_SECONDS=30
STALE_MS=3000

MARKET_STATUS=open
MIN_24H_VOLUME=1000
MAX_SPREAD_CENTS=8
MIN_SPREAD_CENTS=2
MIN_DEPTH_CONTRACTS=10

# ── Risk / Capital ───────────────────────────────────────────────────
START_BANKROLL_DOLLARS=500
DAILY_STOP_DOLLARS=200
MAX_GROSS_EXPOSURE_DOLLARS=250
MAX_NET_EXPOSURE_DOLLARS=150
MAX_EXPOSURE_PER_MARKET_DOLLARS=125
MAX_ORDER_SIZE_CONTRACTS=25
NO_TRADE_WINDOW_SECONDS=300

# ── Market-Making ────────────────────────────────────────────────────
MM_ENABLED=true
MM_QUOTE_SIZE_CONTRACTS=10
MM_EDGE_CENTS=1
MM_INVENTORY_SKEW=0.25
MM_CANCEL_REQUOTE_MS=800
MM_ONLY_WHEN_VOL_BELOW=0.55

# ── Sniper ───────────────────────────────────────────────────────────
SNIPER_ENABLED=true
SNIPER_MIN_EDGE_CENTS=6
SNIPER_MAX_SLIPPAGE_CENTS=2
SNIPER_ORDER_TIF=immediate_or_cancel
SNIPER_COOLDOWN_SECONDS=10
